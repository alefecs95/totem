# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/totem_festival

# Servidor
PORT=3001

# Domínio do PWA do totem (usado na URL de setup do QR Code)
FRONTEND_URL=https://totem-pwa.seudominio.com
# Domínio do painel admin
ADMIN_URL=https://totem-admin.seudominio.com
# Origens extras permitidas no CORS (separadas por vírgula) — opcional
CORS_ORIGINS=
# URL pública desta API (usada no notification_url dos webhooks do Mercado Pago)
PUBLIC_URL=https://totem-api.seudominio.com

# Autenticação do painel admin
ADMIN_JWT_SECRET=troque_por_string_aleatoria_longa_minimo_32_chars

# Comissão padrão da plataforma (percentual, ex: 5 = 5%)
COMISSAO_PADRAO=5

# Mercado Pago (token global de fallback — opcional; o normal é por tenant)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# SumUp (chave global de fallback — opcional; o normal é por tenant)
SUMUP_API_KEY=
