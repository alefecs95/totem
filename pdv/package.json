{
  "name": "totem-pdv",
  "version": "1.0.0",
  "private": true,
  "description": "PDV Electron — venda e impressão de fichas por código do evento",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5180 && electron .\"",
    "electron:build": "vite build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "build": {
    "appId": "br.totem.pdv",
    "productName": "Totem PDV",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis"] }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
